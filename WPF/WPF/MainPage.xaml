<Window x:Class="WPF.MainPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF"
        mc:Ignorable="d"
        Title="MainPage" Height="450" Width="800">
    <Grid Background="Red">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Background="AliceBlue" Padding="15" Grid.Column="0">
            <StackPanel Name="TreeElement">
                <TreeView x:Name="Tree" Height="250">
                </TreeView>
                <Button Content="Создать папку" Margin="0,5,0,5" Click="CreateFolder_Click"/>
                <TextBlock Text="Notes_Project" Width="74" Padding="0,5,0,0" Height="22"/>
                <TextBlock x:Name="LoginText" Text="Login: TestLogin" Width="160" />
                <TextBlock x:Name="EmailText" Text="Email: TestEmail" Width="160" />
                <TextBlock x:Name="DateText" Text="Дата: 01.01.2023" Width="160" />
                <Button Content="Выйти" Margin="0,10,0,0" Click="LogoutButton_Click"></Button>
            </StackPanel>
        </Border>

        <StackPanel Grid.Column="1" Margin="10">
            <TextBlock Text="Название заметки:" Foreground="White"/>
            <TextBox x:Name="NoteNameBox" Width="200" HorizontalAlignment="Left" Margin="0,0,0,10"/>
            <TextBlock Text="Текст заметки:" Foreground="White"/>
            <TextBox x:Name="NoteTextBox" Height="200" AcceptsReturn="True" TextWrapping="Wrap"/>
            <Button Content="Сохранить заметку" Width="150" HorizontalAlignment="Left" Margin="0,10,0,0" Click="SaveNote_Click"/>
        </StackPanel>
    </Grid>
</Window>